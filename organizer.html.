
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CrownVotes | Organiser Portal</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f3fa;color:#241b3d;font-family:Arial,sans-serif}
header{background:#29145f;color:white;padding:20px}
header h1{margin:0;font-size:24px}
header p{margin:6px 0 0;color:#ded5f4}
main{max-width:950px;margin:22px auto;padding:0 14px}
.card{background:white;padding:20px;margin-bottom:16px;border-radius:13px;box-shadow:0 3px 14px #21104412}
h2{margin-top:0;color:#29145f}
input,textarea,button{width:100%;padding:13px;margin:7px 0;border-radius:8px;font-size:15px}
input,textarea{border:1px solid #d8d1e5;background:white}
textarea{min-height:90px;resize:vertical}
button{border:0;background:#392078;color:white;font-weight:bold;cursor:pointer}
button.secondary{background:#eee9f7;color:#29145f}
button.danger{background:#a62c45}
.hidden{display:none!important}
.muted{color:#777;font-size:14px}
.message{padding:11px;border-radius:7px;background:#f0ebfa;margin:10px 0;white-space:pre-wrap}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{background:#f1edfa;padding:14px;border-radius:9px}
.stat strong{display:block;font-size:22px;margin-top:7px}
.item{border:1px solid #e6e0ef;padding:13px;border-radius:9px;margin:10px 0}
.item h3{margin:0 0 7px}
.topline{display:flex;justify-content:space-between;gap:10px;align-items:center}
small{color:#777}
@media(min-width:650px){.stats{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<header>
<h1>🏆 CrownVotes</h1>
<p>Organiser Control Centre</p>
</header>

<main>
<div id="authArea" class="card">
<h2 id="authTitle">Organiser Login</h2>
<div id="authMessage" class="message hidden"></div>

<div id="loginForm">
<input id="loginEmail" type="email" placeholder="Email address">
<input id="loginPassword" type="password" placeholder="Password">
<button onclick="login()">Sign In</button>
<button class="secondary" onclick="showRegister()">Create an Account</button>
</div>

<div id="registerForm" class="hidden">
<input id="regName" placeholder="Your full name">
<input id="regEmail" type="email" placeholder="Email address">
<input id="regPassword" type="password" placeholder="Password (minimum 10 characters)">
<button onclick="register()">Create Account</button>
<button class="secondary" onclick="showLogin()">Back to Login</button>
</div>
</div>

<div id="applicationArea" class="card hidden">
<h2>Organiser Application</h2>
<p>Submit your details to request organiser access. Your account must be approved before you can create voting events.</p>
<div id="applicationMessage" class="message"></div>
<input id="organisation" placeholder="Organisation or brand name">
<input id="phone" placeholder="Phone number">
<textarea id="details" placeholder="Tell us about your organisation and the events you want to organise"></textarea>
<button onclick="submitApplication()">Submit Application</button>
<button class="secondary" onclick="logout()">Sign Out</button>
</div>

<div id="dashboard" class="hidden">
<div class="card">
<div class="topline">
<h2>Organiser Dashboard</h2>
<button style="width:auto" onclick="logout()">Sign Out</button>
</div>
<p id="welcome" class="muted"></p>
<div class="stats">
<div class="stat">Total Votes<strong id="totalVotes">0</strong></div>
<div class="stat">Gross Sales<strong id="gross">GH₵0.00</strong></div>
<div class="stat">Your Earnings<strong id="earned">GH₵0.00</strong></div>
<div class="stat">Available Balance<strong id="available">GH₵0.00</strong></div>
</div>
</div>

<div class="card">
<h2>Create a Voting Event</h2>
<input id="eventTitle" placeholder="Event title">
<textarea id="eventDescription" placeholder="Describe your event"></textarea>
<label>Event start date</label>
<input id="eventStart" type="datetime-local">
<label>Event closing date</label>
<input id="eventEnd" type="datetime-local">
<label>Price per vote (GH₵)</label>
<input id="votePrice" type="number" min="0.01" step="0.01" placeholder="Example: 1.00">
<button onclick="createEvent()">Create Event</button>
<div id="eventMessage" class="message hidden"></div>
</div>

<div class="card">
<h2>My Voting Events</h2>
<div id="eventsList">Loading events...</div>
</div>

<div class="card">
<h2>Recent Payments</h2>
<div id="paymentsList">Loading payments...</div>
</div>

<div class="card">
<h2>Payout History</h2>
<div id="payoutsList">Loading payouts...</div>
</div>
</div>

<div id="eventManager" class="hidden">
<div class="card">
<button class="secondary" onclick="backToDashboard()">← Back to Dashboard</button>
<h2 id="manageTitle">Manage Event</h2>
<div id="manageMessage" class="message hidden"></div>

<h3>Event Categories</h3>
<input id="categoryName" placeholder="Category name">
<textarea id="categoryDescription" placeholder="Category description"></textarea>
<button onclick="addCategory()">Add Category</button>
<div id="categoriesList"></div>

<hr>
<h3>Add Contestant / Nominee</h3>
<select id="nomineeCategory" style="width:100%;padding:13px;border:1px solid #d8d1e5;border-radius:8px">
<option value="">Select category</option>
</select>
<input id="nomineeName" placeholder="Contestant's full name">
<textarea id="nomineeBio" placeholder="Contestant biography"></textarea>
<input id="nomineeImage" placeholder="Contestant image URL (optional)">
<button onclick="addNominee()">Add Nominee</button>

<h3>Contestants and Voting Codes</h3>
<div id="nomineesList"></div>
</div>
</div>
</main>

<script>
const API = '/api';
const TOKEN_KEY = 'crownvotes_organizer_token';
let token = localStorage.getItem(TOKEN_KEY) || '';
let currentEvent = null;
let currentCategories = [];

function money(value){
  return 'GH₵' + (Number(value || 0) / 100).toFixed(2);
}

function show(id){
  ['authArea','applicationArea','dashboard','eventManager'].forEach(x=>{
    document.getElementById(x).classList.add('hidden');
  });
  document.getElementById(id).classList.remove('hidden');
}

function message(id,text){
  const el=document.getElementById(id);
  el.textContent=text;
  el.classList.remove('hidden');
}

async function api(path,options={}){
  const headers={'Content-Type':'application/json',...(options.headers||{})};
  if(token) headers.Authorization='Bearer '+token;
  const response=await fetch(API+path,{...options,headers});
  const data=await response.json().catch(()=>({}));
  if(!response.ok) throw new Error(data.error || 'Request failed. Please try again.');
  return data;
}

function showRegister(){
  document.getElementById('loginForm').classList.add('hidden');
  document.getElementById('registerForm').classList.remove('hidden');
  document.getElementById('authTitle').textContent='Create Organiser Account';
}

function showLogin(){
  document.getElementById('registerForm').classList.add('hidden');
  document.getElementById('loginForm').classList.remove('hidden');
  document.getElementById('authTitle').textContent='Organiser Login';
}

async function login(){
  const email=document.getElementById('loginEmail').value.trim();
  const password=document.getElementById('loginPassword').value;
  try{
    const result=await api('/auth/login',{method:'POST',body:JSON.stringify({email,password})});
    token=result.token;
    localStorage.setItem(TOKEN_KEY,token);
    await checkAccount();
  }catch(e){message('authMessage',e.message);}
}

async function register(){
  const name=document.getElementById('regName').value.trim();
  const email=document.getElementById('regEmail').value.trim();
  const password=document.getElementById('regPassword').value;
  try{
    const result=await api('/auth/register',{method:'POST',body:JSON.stringify({name,email,password})});
    token=result.token;
    localStorage.setItem(TOKEN_KEY,token);
    await checkAccount();
  }catch(e){message('authMessage',e.message);}
}

async function checkAccount(){
  try{
    const user=await api('/me');
    document.getElementById('welcome').textContent='Welcome, '+user.name;
    if(user.role==='organiser'||user.role==='admin'){
      show('dashboard');
      await loadDashboard();
    }else{
      show('applicationArea');
      await loadApplication();
    }
  }catch(e){
    token='';
    localStorage.removeItem(TOKEN_KEY);
    show('authArea');
    message('authMessage',e.message);
  }
}

async function loadApplication(){
  try{
    const a=await api('/organiser/application');
    const status=a.status || a.application?.status || 'not submitted';
    document.getElementById('applicationMessage').textContent=
      'Application status: '+status+'. Submit your details below if you have not applied yet.';
  }catch(e){
    document.getElementById('applicationMessage').textContent=e.message;
  }
}

async function submitApplication(){
  const organisation=document.getElementById('organisation').value.trim();
  const phone=document.getElementById('phone').value.trim();
  const details=document.getElementById('details').value.trim();
  try{
    await api('/organiser/apply',{method:'POST',body:JSON.stringify({organisation,phone,details})});
    message('applicationMessage','Your organiser application has been submitted. Please wait for administrator approval.');
  }catch(e){message('applicationMessage',e.message);}
}

async function loadDashboard(){
  try{
    const data=await api('/organiser/dashboard');
    const stats=data.stats || data;
    document.getElementById('totalVotes').textContent=stats.total_votes ?? stats.votes ?? 0;
    document.getElementById('gross').textContent=money(stats.gross);
    document.getElementById('earned').textContent=money(stats.earned);
    document.getElementById('available').textContent=money(stats.available);
    renderEvents(data.events || []);
    renderPayments(data.recent_payments || []);
    renderPayouts(data.payouts || []);
  }catch(e){
    document.getElementById('eventsList').textContent=e.message;
  }
}

function renderEvents(events){
  const el=document.getElementById('eventsList');
  if(!events.length){el.textContent='You have not created any events yet.';return;}
  el.innerHTML='';
  events.forEach(event=>{
    const item=document.createElement('div');
    item.className='item';
    const title=document.createElement('h3');
    title.textContent=event.title || 'Untitled event';
    const info=document.createElement('p');
    info.textContent='Status: '+(event.status || 'draft')+' | Event ID: '+event.id;
    const btn=document.createElement('button');
    btn.textContent='Manage Event';
    btn.onclick=()=>openEvent(event.id,event.title);
    item.append(title,info,btn);
    el.appendChild(item);
  });
}

function renderPayments(items){
  const el=document.getElementById('paymentsList');
  if(!items.length){el.textContent='No payments recorded yet.';return;}
  el.innerHTML='';
  items.forEach(p=>{
    const div=document.createElement('div');
    div.className='item';
    div.textContent='Payment: '+money(p.amount)+' | Status: '+(p.status || 'Unknown');
    el.appendChild(div);
  });
}

function renderPayouts(items){
  const el=document.getElementById('payoutsList');
  if(!items.length){el.textContent='No payouts recorded yet.';return;}
  el.innerHTML='';
  items.forEach(p=>{
    const div=document.createElement('div');
    div.className='item';
    div.textContent='Payout: '+money(p.amount)+' | Status: '+(p.status || 'Unknown');
    el.appendChild(div);
  });
}

async function createEvent(){
  const title=document.getElementById('eventTitle').value.trim();
  const description=document.getElementById('eventDescription').value.trim();
  const start_at=document.getElementById('eventStart').value;
  const end_at=document.getElementById('eventEnd').value;
  const price=Number(document.getElementById('votePrice').value);
  if(!title||!description||!price||price<=0){
    message('eventMessage','Enter an event title, description and valid vote price.');
    return;
  }
  try{
    await api('/organiser/events',{method:'POST',body:JSON.stringify({
      title,description,start_at,end_at,vote_price:Math.round(price*100)
    })});
    message('eventMessage','Event created successfully. It is saved as a draft pending the required approval.');
    await loadDashboard();
  }catch(e){message('eventMessage',e.message);}
}

async function openEvent(id,title){
  currentEvent=id;
  document.getElementById('manageTitle').textContent=title || 'Manage Event';
  show('eventManager');
  await loadEvent();
}

async function loadEvent(){
  try{
    const data=await api('/organiser/events/'+currentEvent);
    currentCategories=data.categories || [];
    renderCategories();
    renderNominees(data.nominees || []);
  }catch(e){message('manageMessage',e.message);}
}

function renderCategories(){
  const list=document.getElementById('categoriesList');
  const select=document.getElementById('nomineeCategory');
  list.innerHTML='';
  select.innerHTML='<option value="">Select category</option>';
  currentCategories.forEach(c=>{
    const item=document.createElement('div');
    item.className='item';
    item.textContent=c.name;
    list.appendChild(item);
    const option=document.createElement('option');
    option.value=c.id;
    option.textContent=c.name;
    select.appendChild(option);
  });
}

function renderNominees(nominees){
  const list=document.getElementById('nomineesList');
  list.innerHTML='';
  if(!nominees.length){list.textContent='No nominees added yet.';return;}
  nominees.forEach(n=>{
    const item=document.createElement('div');
    item.className='item';
    const heading=document.createElement('h3');
    heading.textContent=n.name;
    const bio=document.createElement('p');
    bio.textContent=n.bio || '';
    const code=document.createElement('strong');
    code.textContent='Voting code: '+(n.short_code || 'Not assigned');
    const votes=document.createElement('p');
    votes.textContent='Votes: '+(n.vote_count ?? n.votes ?? 0);
    item.append(heading,bio,code,votes);
    list.appendChild(item);
  });
}

async function addCategory(){
  const name=document.getElementById('categoryName').value.trim();
  const description=document.getElementById('categoryDescription').value.trim();
  if(!name){message('manageMessage','Enter a category name.');return;}
  try{
    await api('/organiser/events/'+currentEvent+'/categories',{
      method:'POST',body:JSON.stringify({name,description})
    });
    document.getElementById('categoryName').value='';
    document.getElementById('categoryDescription').value='';
    await loadEvent();
    message('manageMessage','Category added.');
  }catch(e){message('manageMessage',e.message);}
}

async function addNominee(){
  const category_id=document.getElementById('nomineeCategory').value;
  const name=document.getElementById('nomineeName').value.trim();
  const bio=document.getElementById('nomineeBio').value.trim();
  const image_url=document.getElementById('nomineeImage').value.trim();
  if(!category_id||!name){message('manageMessage','Select a category and enter the nominee name.');return;}
  try{
    await api('/organiser/categories/'+category_id+'/nominees',{
      method:'POST',body:JSON.stringify({name,bio,image_url})
    });
    document.getElementById('nomineeName').value='';
    document.getElementById('nomineeBio').value='';
    document.getElementById('nomineeImage').value='';
    await loadEvent();
    message('manageMessage','Nominee added successfully.');
  }catch(e){message('manageMessage',e.message);}
}

function backToDashboard(){
  show('dashboard');
  loadDashboard();
}

function logout(){
  token='';
  localStorage.removeItem(TOKEN_KEY);
  show('authArea');
  showLogin();
}

if(token){checkAccount();}else{show('authArea');}
</script>
</body>
</html>
